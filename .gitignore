# Generated repositories and package artifacts are published through APT.
/build/
/artifacts/
/dist/
/work/
/outputs/
*.deb
*.udeb
*.ddeb
*.changes
*.buildinfo
*.dsc
*.orig.tar.*
*.debian.tar.*
*.diff.gz
/*.tar
/*.tar.*
/*.zip

# Dependency directories and local tool caches are regenerated locally.
/.cache/
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.wrangler/

# Environment examples remain available without exposing local credentials.
.env*
*.env
!.env.example
!.env.template
!*.env.example
!*.env.template

# Deployment settings stay local while the named configuration examples are public.
/config/*.json
!/config/repository.example.json
!/config/caddy-proxy-host.example.json
!/config/cloudflare.example.json
!/config/deployment.example.json

.netrc
.npmrc
.pypirc
.git-credentials
.aws/
.ssh/
.gnupg/
private-keys-v1.d/
secrets/
credentials/
secrets.json
credentials.json
*.token
*.token.*
.cloudflare-token*
*.local
*.local.*
*.secrets.*
*.credentials.*
/config/secrets*.json
/config/credentials*.json
/config/*token*.json
/config/*token*.txt

# Key containers, local archive keyrings, and TLS material stay out of Git.
*.key
*.key.*
*.pem
*.p12
*.pfx
*.p8
*.pk8
*.der
*.jks
*.keystore
*.kbx
*.gpg
*.pgp
*.asc
id_rsa
id_ecdsa
id_ed25519
id_dsa
id_ecdsa_sk
id_ed25519_sk
/keys/

# Logs, database copies, and backups can contain operational credentials.
logs/
backups/
*.log
*.log.*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.bak
*.backup
*.old
*.orig
*.save

# Editor recovery files and operating-system metadata are local state.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
